#!/usr/bin/env bash
# shellcheck disable=SC2016  # jq filters are meant to stay in single quotes
set -euo pipefail
# hy2-client: manage Hysteria2 identities of a hysteria-vps-kit server.
self=$(readlink -f -- "${BASH_SOURCE[0]}")
project=$(dirname -- "$self")
# shellcheck source=lib/common.sh
source "$project/lib/common.sh"

usage() {
    cat << 'EOF'
Usage: hy2-client <command> [arguments]

  add NAME            create an identity (own password) and print its URI
  remove NAME         delete an identity
  list                list identities
  show NAME [--yaml [--http ADDR] [--socks ADDR] | --qr]
                      print the hysteria2:// URI (default), a client.yaml for the
                      Hysteria2 client / proxy container, or a QR code
  doctor              read-only diagnostics on configuration, certificates, unit, and service
  version             kit and core versions
  help                this text

Adding or removing an identity restarts the service (Hysteria2 has no hot reload).
Connected clients notice after the QUIC idle timeout and reconnect on their own:
measured about 30 seconds of interruption.
EOF
}

doctor() {
    local ok_count=0 warn_count=0 fail_count=0 skip_count=0
    report_ok() { ok_count=$((ok_count + 1)); printf '[ OK ] %s\n' "$1"; }
    report_warn() { warn_count=$((warn_count + 1)); printf '[WARN] %s\n' "$1"; }
    report_fail() { fail_count=$((fail_count + 1)); printf '[FAIL] %s\n' "$1"; }
    report_skip() { skip_count=$((skip_count + 1)); printf '[SKIP] %s\n' "$1"; }

    local tmp_dir
    tmp_dir=$(mktemp -d "${HVK_ROOT:-}/tmp/hvk-doctor.XXXXXX" 2>/dev/null || mktemp -d "/tmp/hvk-doctor.XXXXXX")
    cleanup_doctor() { rm -rf "$tmp_dir"; }
    trap cleanup_doctor EXIT

    # 1. state.json reads and passes validation
    local state_valid=0 state_err=""
    if [[ ! -f $HVK_STATE ]]; then
        report_fail "state.json: file is missing ($HVK_STATE)"
    elif ! jq empty "$HVK_STATE" >/dev/null 2>&1; then
        report_fail "state.json: invalid JSON syntax"
    elif ! state_err=$(hvk_validate_state 2>&1); then
        report_fail "state.json: ${state_err#*error: }"
    else
        state_valid=1
        local st_status
        st_status=$(jq -r '.status // "ready"' "$HVK_STATE" 2>/dev/null || echo "unknown")
        if [[ $st_status != "ready" ]]; then
            report_warn "state.json is valid but status is '$st_status'"
        else
            report_ok "state.json is valid (status: $st_status)"
        fi
    fi

    local port core_expected sni obfs_enabled obfs_password endpoint
    if (( state_valid )); then
        port=$(hvk_state_get .port)
        core_expected=$(hvk_state_get .core)
        sni=$(hvk_state_get .sni)
        obfs_enabled=$(hvk_state_get .obfs.enabled)
        obfs_password=$(hvk_state_get .obfs.password)
        endpoint=$(hvk_state_get .endpoint)
    else
        port="" core_expected="$HVK_CORE_VERSION" sni="" obfs_enabled="false" obfs_password="" endpoint=""
    fi

    # 2. core: file executable, version executes, version contains state.core
    if [[ ! -f $HVK_CORE_BIN ]]; then
        report_fail "core binary: file missing ($HVK_CORE_BIN)"
    elif [[ ! -x $HVK_CORE_BIN ]]; then
        report_fail "core binary: file not executable ($HVK_CORE_BIN)"
    else
        local core_out
        core_out=$("$HVK_CORE_BIN" version 2>&1 || true)
        if [[ -n $core_expected && $core_out == *"$core_expected"* ]]; then
            report_ok "core binary is executable and matches expected version ($core_expected)"
        else
            report_fail "core binary: execution failed or version mismatch (expected $core_expected)"
        fi
    fi

    # 3. unit exists, ExecStart contains HVK_CORE_BIN and HVK_CONFIG
    if [[ ! -f $HVK_UNIT ]]; then
        report_fail "systemd unit: file missing ($HVK_UNIT)"
    else
        local exec_line
        exec_line=$(grep '^ExecStart=' "$HVK_UNIT" 2>/dev/null || true)
        if [[ $exec_line == *"${HVK_CORE_BIN#"$HVK_ROOT"}"* || $exec_line == *"$HVK_CORE_BIN"* ]] && \
           [[ $exec_line == *"${HVK_CONFIG#"$HVK_ROOT"}"* || $exec_line == *"$HVK_CONFIG"* ]]; then
            report_ok "systemd unit exists and references core binary and config"
        else
            report_fail "systemd unit: ExecStart does not reference core binary and config"
        fi
    fi

    # 4. service is-active and is-enabled
    if [[ -n $HVK_ROOT ]]; then
        report_skip "service status (sandbox mode)"
    else
        local is_act is_enb
        is_act=$(systemctl is-active "$HVK_SERVICE" 2>/dev/null || true)
        [[ -n $is_act ]] || is_act="inactive"
        is_enb=$(systemctl is-enabled "$HVK_SERVICE" 2>/dev/null || true)
        [[ -n $is_enb ]] || is_enb="disabled"
        if [[ $is_act == "active" && $is_enb == "enabled" ]]; then
            report_ok "service is active and enabled"
        else
            report_fail "service status: active=$is_act, enabled=$is_enb"
        fi
    fi

    # 5. config.yaml exists; render matches file; permissions 640
    if [[ ! -f $HVK_CONFIG ]]; then
        report_fail "config.yaml does not exist ($HVK_CONFIG)"
    elif (( ! state_valid )); then
        report_fail "config.yaml cannot be verified because state.json is invalid"
    else
        local tmp_rendered="$tmp_dir/config.yaml.rendered"
        if hvk_render_config_to "$tmp_rendered" 2>/dev/null && cmp -s "$tmp_rendered" "$HVK_CONFIG"; then
            local cfg_mode
            cfg_mode=$(stat -c '%a' "$HVK_CONFIG" 2>/dev/null || echo "unknown")
            if [[ $cfg_mode == "640" ]]; then
                report_ok "config.yaml matches state and has mode 640"
            else
                report_warn "config.yaml matches state but permissions are $cfg_mode (expected 640)"
            fi
        else
            report_fail "config.yaml does not match rendered state"
        fi
    fi

    # 6. cert and key exist; key matches cert; pin in state matches
    if [[ ! -f $HVK_CERT ]]; then
        report_fail "certificate/key: certificate file missing ($HVK_CERT)"
    elif [[ ! -f $HVK_KEY ]]; then
        report_fail "certificate/key: private key file missing ($HVK_KEY)"
    else
        local cert_pub key_pub
        cert_pub=$(openssl x509 -in "$HVK_CERT" -pubkey -noout 2>/dev/null || true)
        key_pub=$(openssl pkey -in "$HVK_KEY" -pubout 2>/dev/null || true)
        if [[ -z $cert_pub || -z $key_pub || "$cert_pub" != "$key_pub" ]]; then
            report_fail "certificate/key: private key does not match certificate"
        else
            local actual_pin state_pin
            actual_pin=$(hvk_pin "$HVK_CERT" 2>/dev/null || true)
            state_pin=$(jq -r '.pin // empty' "$HVK_STATE" 2>/dev/null || true)
            if [[ -z $state_pin || "$actual_pin" != "$state_pin" ]]; then
                report_fail "certificate/key: certificate pin does not match state.json"
            else
                report_ok "certificate/key pair matches and pin is consistent"
            fi
        fi
    fi

    # 7. obfs: if enabled, password non-empty and block exists in config
    if [[ $obfs_enabled == "true" ]]; then
        if [[ -z $obfs_password ]]; then
            report_fail "obfuscation: enabled in state but password is empty"
        elif [[ ! -f $HVK_CONFIG ]] || ! grep -q 'type: salamander' "$HVK_CONFIG" 2>/dev/null; then
            report_fail "obfuscation: enabled in state but missing in config.yaml"
        else
            report_ok "obfuscation: enabled (salamander)"
        fi
    else
        report_ok "obfuscation: disabled"
    fi

    # 8. clients: state.clients non-empty (warn if 0)
    local client_count=0
    if (( state_valid )); then
        client_count=$(jq -r '.clients // {} | length' "$HVK_STATE" 2>/dev/null || echo 0)
    fi
    if (( client_count > 0 )); then
        report_ok "clients: $client_count configured"
    else
        report_warn "clients: 0 configured"
    fi

    # 9. port: hvk_valid_port, UDP listens on state.port
    if ! hvk_valid_port "$port"; then
        report_fail "port: invalid port in state ($port)"
    elif [[ -n $HVK_ROOT ]]; then
        report_skip "port: listening check (sandbox mode)"
    else
        if ss -ulnH "sport = :$port" 2>/dev/null | grep -q ":$port\b"; then
            report_ok "port: UDP port $port is listening"
        else
            report_fail "port: UDP port $port is not listening"
        fi
    fi

    # 10. sysctl: file matches expected; effective rmem_max/wmem_max >= 7500000
    if [[ -n $HVK_ROOT ]]; then
        report_skip "sysctl buffers (sandbox mode)"
    else
        local cur_rmem cur_wmem sysctl_file="/etc/sysctl.d/99-hysteria-vps-kit.conf"
        cur_rmem=$(sysctl -n net.core.rmem_max 2>/dev/null || echo 0)
        cur_wmem=$(sysctl -n net.core.wmem_max 2>/dev/null || echo 0)
        [[ $cur_rmem =~ ^[0-9]+$ ]] || cur_rmem=0
        [[ $cur_wmem =~ ^[0-9]+$ ]] || cur_wmem=0
        if [[ -f $sysctl_file ]] && (( cur_rmem >= 7500000 && cur_wmem >= 7500000 )); then
            report_ok "sysctl: UDP receive/send buffers optimal (rmem_max=$cur_rmem, wmem_max=$cur_wmem)"
        else
            report_warn "sysctl: UDP buffers sub-optimal (rmem_max=$cur_rmem, wmem_max=$cur_wmem; recommended >= 7500000)"
        fi
    fi

    # 11. endpoint: valid, not placeholder, not private
    if ! hvk_valid_endpoint "$endpoint"; then
        report_warn "endpoint: invalid endpoint '$endpoint'"
    elif [[ $endpoint == "YOUR_SERVER_IP" ]]; then
        report_warn "endpoint: placeholder 'YOUR_SERVER_IP' is still set"
    elif hvk_is_private_ip "$endpoint"; then
        report_warn "endpoint: '$endpoint' is a private/local IP address"
    else
        report_ok "endpoint: $endpoint"
    fi

    # 12. firewall: ufw active and rule for port exists; if state.firewall == ufw, rule required
    if [[ -n $HVK_ROOT ]]; then
        report_skip "firewall status (sandbox mode)"
    else
        local fw_state
        fw_state=$(jq -r '.firewall // empty' "$HVK_STATE" 2>/dev/null || true)
        if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q 'Status: active'; then
            if ufw status 2>/dev/null | grep -q "$port/udp"; then
                report_ok "firewall: ufw is active and allows UDP port $port"
            else
                report_warn "firewall: ufw is active but no rule allows UDP port $port"
            fi
        else
            if [[ $fw_state == "ufw" ]]; then
                report_warn "firewall: state records firewall=ufw but ufw is not active"
            else
                report_ok "firewall: ufw not active (unmanaged or other firewall in use)"
            fi
        fi
    fi

    # 13. kit version: VERSION matches state.version
    local repo_ver state_ver
    repo_ver=$(hvk_project_version "$project")
    state_ver=$(jq -r '.version // empty' "$HVK_STATE" 2>/dev/null || true)
    if [[ -n $state_ver && "$repo_ver" == "$state_ver" ]]; then
        report_ok "kit version: $repo_ver matches state"
    else
        report_warn "kit version: mismatch (installed: $state_ver, kit files: $repo_ver)"
    fi

    trap - EXIT
    cleanup_doctor

    printf 'doctor: %d ok, %d warnings, %d failures\n' "$ok_count" "$warn_count" "$fail_count"
    (( fail_count == 0 )) || return 1
    return 0
}

cmd=${1:-help}
[[ $# -eq 0 ]] || shift
case $cmd in
    help|-h|--help) usage ;;
    doctor)
        hvk_require_root
        doctor
        ;;
    version)
        hvk_require_state
        printf 'hysteria-vps-kit %s, Hysteria2 core %s\n' "$(hvk_project_version "$project")" "$(hvk_state_get .core)"
        ;;
    list)
        hvk_require_state
        jq -r '.clients | keys[]' "$HVK_STATE"
        ;;
    add)
        hvk_require_root; hvk_require_state
        hvk_lock
        name=${1:-}; [[ -n $name ]] || { usage >&2; exit 2; }
        hvk_valid_name "$name" || hvk_die "invalid name: $name (letters, digits, _ . @ -, up to 32, start with a letter or digit)"
        if hvk_client_name_conflict "$name"; then
            hvk_die "client already exists (case-insensitive conflict): $name"
        fi
        state_bak=$(mktemp "$HVK_ETC/.state.bak.XXXXXX")
        config_bak=$(mktemp "$HVK_ETC/.config.bak.XXXXXX")
        cleanup_add() { rm -f "$state_bak" "$config_bak"; }
        trap cleanup_add EXIT ERR
        cp -pf "$HVK_STATE" "$state_bak"
        cp -pf "$HVK_CONFIG" "$config_bak"

        rollback_add() {
            trap - EXIT ERR
            cp -pf "$state_bak" "$HVK_STATE"
            cp -pf "$config_bak" "$HVK_CONFIG"
            cleanup_add
            if hvk_restart_service; then
                hvk_die "failed to add client '$name': service did not start; restored previous configuration"
            else
                hvk_die "CRITICAL: failed to add client '$name' and failed to restore service; check logs: journalctl -u $HVK_SERVICE -n 30"
            fi
        }

        hvk_state_update '.clients[$n] = $p' --arg n "$name" --arg p "$(hvk_rand 28)" || rollback_add
        hvk_render_config || rollback_add
        if ! hvk_restart_service; then
            rollback_add
        fi
        trap - EXIT ERR
        cleanup_add
        printf 'Client %s\nURI:\n' "$name"
        hvk_client_uri "$name"
        ;;
    remove)
        hvk_require_root; hvk_require_state
        hvk_lock
        name=${1:-}; [[ -n $name ]] || { usage >&2; exit 2; }
        actual_name=$(jq -r --arg n "$name" '.clients | keys[] | select(. == $n)' "$HVK_STATE" 2>/dev/null || true)
        [[ -n $actual_name ]] || hvk_die "no such client: $name"

        state_bak=$(mktemp "$HVK_ETC/.state.bak.XXXXXX")
        config_bak=$(mktemp "$HVK_ETC/.config.bak.XXXXXX")
        cleanup_remove() { rm -f "$state_bak" "$config_bak"; }
        trap cleanup_remove EXIT ERR
        cp -pf "$HVK_STATE" "$state_bak"
        cp -pf "$HVK_CONFIG" "$config_bak"

        fail_closed_remove() {
            trap - EXIT ERR
            cleanup_remove
            [[ -n $HVK_ROOT ]] || systemctl stop "$HVK_SERVICE" > /dev/null 2>&1 || true
            hvk_die "CRITICAL: client '$actual_name' was revoked, but applying configuration or restarting the service failed. To prevent restoring revoked access, the service was stopped. Check logs: journalctl -u $HVK_SERVICE -n 30"
        }

        hvk_state_update 'del(.clients[$n])' --arg n "$actual_name" || fail_closed_remove
        hvk_render_config || fail_closed_remove
        if ! hvk_restart_service; then
            fail_closed_remove
        fi
        trap - EXIT ERR
        cleanup_remove
        hvk_log "removed $actual_name"
        ;;
    show)
        hvk_require_state
        name=${1:-}; [[ -n $name ]] || { usage >&2; exit 2; }
        shift
        mode=uri http=127.0.0.1:8080 socks=127.0.0.1:1080
        while (( $# )); do
            case $1 in
                --yaml) mode=yaml; shift ;;
                --qr) mode=qr; shift ;;
                --http) http=${2:?--http needs a value}; shift 2 ;;
                --socks) socks=${2:?--socks needs a value}; shift 2 ;;
                *) hvk_die "unknown option: $1" ;;
            esac
        done
        case $mode in
            uri) hvk_client_uri "$name" ;;
            yaml) hvk_client_yaml "$name" "$http" "$socks" ;;
            qr)
                command -v qrencode > /dev/null || hvk_die 'qrencode is not installed'
                hvk_client_uri "$name" | qrencode -t ANSIUTF8
                ;;
        esac
        ;;
    *) usage >&2; exit 2 ;;
esac
